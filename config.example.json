      "dng",
      "cr2",
      "cr3",
      "nef",
      "arw",
      "raf",
      "rw2",
      "orf"
    ],
    "videos": [
      "mp4",
      "mov",
      "3gp",
      "avi",
      "mts",
      "m2ts",
      "mpg",
      "mpeg",
      "wmv",
      "mkv",
      "m4v",
      "webm",
      "flv",
