{
  "exifTool": "C:\\PATH\\TO\\exiftool.exe",
  "sources": [
    "D:\\PATH\\TO\\SOURCE_1",
    "E:\\PATH\\TO\\SOURCE_2"
  ],
  "destinationRoot": "F:\\PATH\\TO\\ARCHIVE\\Sorted",
  "logDir": "F:\\PATH\\TO\\ARCHIVE\\logs",
